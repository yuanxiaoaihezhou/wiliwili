<brls:AppletFrame iconInterpolation="linear" headerHidden="true" footerHidden="false">
    <brls:Box backgroundColor="@theme/brls/background" axis="column" grow="1">
        <brls:Box height="68" width="100%" alignItems="center" paddingLeft="28" paddingRight="76">
            <brls:Label text="@i18n/wiliwili/download_manager/offline_library" fontSize="26" grow="1"/>
        </brls:Box>
        <RecyclingGrid
                id="download/grid"
                paddingLeft="24"
                paddingRight="24"
                paddingBottom="12"
                grow="1"
                spanCount="@style/wiliwili/grid/span/4"
                itemSpace="14"
                preFetchLine="2"
                flowMode="true"
                itemHeight="318"
                wireframe="false"/>
        <ButtonClose positionType="absolute" positionTop="2" positionRight="2"/>
    </brls:Box>
</brls:AppletFrame>
