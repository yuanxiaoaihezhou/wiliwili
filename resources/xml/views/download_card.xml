<brls:Box
        focusable="true"
        wireframe="false"
        highlightCornerRadius="8"
        axis="column"
        width="auto"
        height="auto">
    <brls:Box
            id="download/pic_box"
            width="100%"
            height="60%">
        <brls:Image
                id="download/cover"
                scalingType="fill"
                height="100%"
                width="100%"
                image="@res/pictures/video-card-bg.png"
                cornerRadius="4"/>

        <brls:Box
                id="download/status_box"
                positionType="absolute"
                positionTop="8"
                positionRight="8"
                cornerRadius="4"
                paddingLeft="7"
                paddingRight="7"
                paddingTop="3"
                paddingBottom="3"
                backgroundColor="@theme/color/bilibili">
            <brls:Label
                    id="download/status"
                    textColor="#FFFFFF"
                    fontSize="12"
                    horizontalAlign="center"
                    singleLine="true"/>
        </brls:Box>

        <brls:Box
                positionBottom="0"
                positionType="absolute"
                background="vertical_linear"
                paddingLeft="10"
                paddingRight="10"
                width="100%"
                height="20%"
                alignItems="center">
            <brls:Label
                    id="download/progress"
                    textColor="#FFFFFF"
                    fontSize="13"
                    singleLine="true"
                    width="72%"/>
            <brls:Label
                    id="download/percent"
                    positionType="absolute"
                    positionRight="10"
                    textColor="#FFFFFF"
                    fontSize="13"
                    horizontalAlign="right"
                    singleLine="true"/>
        </brls:Box>

        <brls:Box
                positionType="absolute"
                positionBottom="0"
                width="100%"
                height="3"
                backgroundColor="#353535">
            <brls:Box
                    id="download/progress_bar"
                    height="3"
                    width="0%"
                    backgroundColor="@theme/color/bilibili"/>
        </brls:Box>
    </brls:Box>

    <brls:Box margin="10" axis="column">
        <TextBox
                id="download/title"
                fontSize="20"
                lineHeight="1.5"
                maxRows="2"
                width="100%"
                height="60"/>
        <brls:Box width="100%" height="20" alignItems="center">
            <SVGImage id="download/up" height="14" width="18" SVG="@res/svg/widget-up.svg"/>
            <brls:Label
                    id="download/meta"
                    marginLeft="4"
                    fontSize="16"
                    singleLine="true"
                    textColor="@theme/font/grey"
                    height="100%"/>
        </brls:Box>
    </brls:Box>
</brls:Box>
